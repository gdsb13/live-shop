API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
WEB_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001

# Agora (backend only — never commit real values; certificate must not reach the browser)
# App ID = 32 hex chars from Agora Console → Project → App ID (not the certificate)
# Signaling data center in Console (e.g. Asia-Pacific). Use AUTO to let the SDK pick the nearest region.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_SIGNALING_AREA=AUTO
