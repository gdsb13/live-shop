API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
WEB_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001

# Agora (backend only — never commit real values; certificate must not reach the browser)
# App ID = 32 hex chars from Agora Console → Project → App ID (not the certificate)
# Signaling data center in Console (e.g. Asia-Pacific). Use AUTO to let the SDK pick the nearest region.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_SIGNALING_AREA=AUTO

# Voice AI (Phase 5) — backend only
# Public HTTPS URL Agora cloud can reach for Custom LLM tool loop (e.g. ngrok http 3001)
AI_PUBLIC_BASE_URL=
# Bearer token Agora uses when calling /api/ai/llm/:channel/chat/completions
AI_CUSTOM_LLM_API_KEY=live-shop-ai-key
# Agora Conversational AI data center (AP, US, EU, etc.)
AGORA_AI_AREA=AP
