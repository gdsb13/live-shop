# Backend: API port (local; Render injects PORT)
API_PORT=3001
# Backend: API bind host
API_HOST=0.0.0.0

# Backend: CORS allowed frontend URL
WEB_ORIGIN=http://localhost:3000
# Local scripts: Next dev port
WEB_PORT=3000
# Local scripts: Next bind host
WEB_HOST=0.0.0.0
# Frontend: browser API URL (also loaded from repo root for local dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend: Agora project id
AGORA_APP_ID=
# Backend: Agora cert — server only, never browser
AGORA_APP_CERTIFICATE=
# Backend: RTM/signaling region
AGORA_SIGNALING_AREA=AUTO

# Backend: Conversational AI region
AGORA_AI_AREA=AP
# Backend: voice agent LLM model
OPENAI_MODEL=gpt-4o-mini

# Backend: public HTTPS API base for Agora MCP (/mcp)
AI_PUBLIC_BASE_URL=
# Backend: MCP URL override (optional)
# MCP_ENDPOINT=

# Backend: custom LLM key (unused in default managed path)
AI_CUSTOM_LLM_API_KEY=
