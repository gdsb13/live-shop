# Voice AI (Phase 5) — backend only
# Public HTTPS base URL (e.g. ngrok http 3001). MCP endpoint defaults to {AI_PUBLIC_BASE_URL}/mcp
AI_PUBLIC_BASE_URL=
# Optional explicit MCP endpoint override (e.g. https://xxxx.ngrok-free.app/mcp)
# MCP_ENDPOINT=
# Managed OpenAI model for Agora Conversational AI (keyless by default)
OPENAI_MODEL=gpt-4o-mini
# Agora Conversational AI data center (AP, US, EU, etc.)
AGORA_AI_AREA=AP
