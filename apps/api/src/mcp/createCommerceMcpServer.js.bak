'use strict';

const { AI_TOOL_DEFINITIONS } = require('../services/aiToolDefinitions');
const { runCommerceTool } = require('./commerceToolRunner');

// Build the MCP server that exposes allowlisted commerce tools.
async function createCommerceMcpServer(requestHeaders) {
  const { McpServer } = await import('@modelcontextprotocol/sdk/server/mcp.js');
  const server = new McpServer({
    name: 'live-shop-commerce',
    version: '1.0.0',
  });

  for (const definition of AI_TOOL_DEFINITIONS) {
    const tool = definition.function;
    server.registerTool(
      tool.name,
      {
        description: tool.description,
        inputSchema: tool.parameters,
      },
      async (args) => {
        const result = runCommerceTool(tool.name, args, requestHeaders);
        return {
          content: [{ type: 'text', text: JSON.stringify(result) }],
        };
      },
    );
  }

  return server;
}

module.exports = {
  createCommerceMcpServer,
};
